# Copy to `.env` (git-ignored) and fill in. Used ONLY by scripts/verify-graph-token.mjs in Phase 0.
# The Worker (Phase 3+) uses bot/.dev.vars and `wrangler secret put` instead.

# Base URL depends on the login flow you chose (see docs/platform-notes.md, V2):
#   Instagram API with Instagram Login  -> https://graph.instagram.com
#   Instagram API with Facebook Login   -> https://graph.facebook.com
GRAPH_BASE_URL=https://graph.instagram.com

# e.g. v23.0. Leave empty to use the unversioned/default path.
GRAPH_API_VERSION=

# Long-lived access token for the shop's Instagram Professional account.
IG_ACCESS_TOKEN=

# Optional: a media ID (e.g. your test Reel) to check that comment-read permission works.
IG_MEDIA_ID=
